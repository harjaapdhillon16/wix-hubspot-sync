# Public URL of this server (HTTPS in production). Used for OAuth redirect, webhook
# signature verification and the embedded script URL.
APP_BASE_URL=https://wix-hubspot.example.com
PORT=3000

# Wix Dev Center -> your app
WIX_APP_ID=
WIX_APP_SECRET=
# Wix Dev Center -> Webhooks -> "Public key" (PEM, keep the newlines escaped or quote it)
WIX_PUBLIC_KEY=

# HubSpot developer account -> your app -> Auth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_APP_ID=
# HUBSPOT_SCOPES defaults to the least-privilege set the app needs.

# Token storage: gcp (Google Secret Manager) in production, local (AES-GCM in SQLite) for development
SECRET_STORE=gcp
GCP_PROJECT_ID=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

DATABASE_PATH=data/app.db
POLL_INTERVAL_SECONDS=300
WEBHOOK_DEBOUNCE_MS=1500
