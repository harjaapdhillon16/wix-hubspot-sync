# Runtime image built on the VM from a locally compiled bundle (dist/ + public/).
FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY dist ./dist
COPY public ./public
USER node
EXPOSE 3000
CMD ["node", "dist/server/index.js"]
