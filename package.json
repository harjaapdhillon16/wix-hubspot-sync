{
  "name": "wix-hubspot-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Wix app: bi-directional Wix <-> HubSpot contact sync, field mapping, and Wix Forms lead capture with UTM attribution.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:dashboard\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:dashboard": "vite",
    "dev:mock": "npm run build:dashboard && tsx dev/mock-stack.ts",
    "build": "npm run build:dashboard && npm run build:server",
    "build:dashboard": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.dashboard.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.2.0",
    "@wix/app-management": "^1.0.173",
    "@wix/crm": "^1.0.1679",
    "@wix/forms": "^1.0.540",
    "@wix/sdk": "^1.21.18",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hubspot/cli": "^8.18.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@wix/design-system": "^1.344.0",
    "@wix/wix-ui-icons-common": "^3.193.0",
    "concurrently": "^10.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
